    "def dino_vector(f):\n",
    "    return np.concatenate([f.mean(0), f.std(0), np.abs(np.diff(f, axis=0)).mean(0)])\n",
    "\n",
    "\n",
    "X_dino = np.stack([dino_vector(f) for f in dino_clips])\n",
    "test_dino = np.load(CACHE / \"test.npy\").astype(np.float32)\n",
    "X_dino_test = np.stack([dino_vector(f) for f in test_dino])\n",
    "print(X_dino.shape, X_dino_test.shape)"
   ]
