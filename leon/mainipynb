    "pose_meta = pd.read_csv(POSE_CACHE / \"pose_train_s30_meta.csv\")\n",
    "pose_kp = np.load(POSE_CACHE / \"pose_train_s30.npy\")\n",
    "pose_box = np.load(POSE_CACHE / \"box_train_s30.npy\")\n",
    "pose_meta[\"video\"] = [(\"cheat/\" if l == 1 else \"normal/\") + v.replace(\".MOV\", \"\") for v, l in zip(pose_meta[\"video\"], pose_meta[\"label\"])]\n",
    "clip_rows, dino_clips, pose_clips = [], [], []\n",
    "for r in train.itertuples():\n",
    "    if r.label == 1 and np.isnan(r.start):\n",
    "        continue\n",
    "    frames = np.load(CACHE / \"train\" / (r.video.replace(\"/\", \"__\") + \".npy\")).astype(np.float32)\n",
    "    idx = np.where(pose_meta[\"video\"] == r.video)[0]\n",
    "    idx = idx[np.argsort(pose_meta[\"start\"].values[idx])]\n",
    "    for c in range(min(len(frames) // STEPS_PER_CLIP, len(idx))):\n",
    "        dino_clips.append(frames[c * STEPS_PER_CLIP:(c + 1) * STEPS_PER_CLIP])\n",
    "        pose_clips.append((pose_kp[idx[c]], pose_box[idx[c]]))\n",
    "        clip_rows.append({\"video\": r.video, \"subject\": r.subject, \"view\": r.view, \"action\": r.action, \"second\": c,\n",
    "                          \"label\": int(r.label == 1 and c + 0.5 >= r.start)})\n",
    "clips = pd.DataFrame(clip_rows)\n",
    "print(\"klip train:\", len(clips), \"| porsi cheating:\", clips[\"label\"].mean().round(3))\n",
    "clips.groupby(\"second\")[\"label\"].mean().round(2).to_frame(\"porsi klip cheating\").T"
