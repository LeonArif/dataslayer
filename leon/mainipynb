    "def pose_series(kp, box):\n",
    "    h = box[:, 3:4] + 1e-6\n",
    "    x, y, s = (kp[..., 0] - box[:, 0:1]) / h, (kp[..., 1] - box[:, 1:2]) / h, kp[..., 2]\n",
    "    msx, msy = (x[:, LSH] + x[:, RSH]) / 2, (y[:, LSH] + y[:, RSH]) / 2\n",
    "    sh_w = np.abs(x[:, LSH] - x[:, RSH]) + 1e-3\n",
    "    d_l = np.hypot(x[:, LWR] - x[:, NOSE], y[:, LWR] - y[:, NOSE])\n",
    "    d_r = np.hypot(x[:, RWR] - x[:, NOSE], y[:, RWR] - y[:, NOSE])\n",
    "    return pd.DataFrame({\n",
    "        \"head_yaw\": (x[:, NOSE] - (x[:, LEAR] + x[:, REAR]) / 2) / sh_w,\n",
    "        \"head_down\": y[:, NOSE] - msy,\n",
    "        \"eye_yaw\": (x[:, NOSE] - (x[:, LEYE] + x[:, REYE]) / 2) / sh_w,\n",
    "        \"ear_vis\": s[:, LEAR] - s[:, REAR],\n",
    "        \"wrist_gap\": np.hypot(x[:, LWR] - x[:, RWR], y[:, LWR] - y[:, RWR]),\n",
    "        \"hand_face\": np.minimum(d_l, d_r),\n",
    "        \"lwr_dx\": x[:, LWR] - msx, \"lwr_dy\": y[:, LWR] - msy,\n",
    "        \"rwr_dx\": x[:, RWR] - msx, \"rwr_dy\": y[:, RWR] - msy,\n",
    "        \"lel_dy\": y[:, LEL] - msy, \"rel_dy\": y[:, REL] - msy,\n",
    "        \"wrist_score\": np.minimum(s[:, LWR], s[:, RWR]),\n",
    "        \"lean_x\": msx, \"lean_y\": msy, \"sh_tilt\": y[:, LSH] - y[:, RSH], \"sh_w\": sh_w,\n",
    "        \"head_speed\": np.r_[0, np.hypot(np.diff(x[:, NOSE]), np.diff(y[:, NOSE]))],\n",
    "        \"hand_speed\": np.r_[0, (np.hypot(np.diff(x[:, LWR]), np.diff(y[:, LWR])) + np.hypot(np.diff(x[:, RWR]), np.diff(y[:, RWR]))) / 2],\n",
    "    })\n",
    "\n",
    "\n",
    "def pose_vector(kp, box):\n",
    "    s = pose_series(kp, np.repeat(box[None], len(kp), 0))\n",
    "    return np.nan_to_num(np.concatenate([s.mean(), s.std(), s.diff().abs().mean()]))\n",
    "\n",
    "\n",
    "X_pose = np.stack([pose_vector(kp, box) for kp, box in pose_clips])\n",
    "test_ids = pd.read_csv(POSE_CACHE / \"pose_test_meta.csv\")[\"id\"]\n",
    "row_of_id = {i: k for k, i in enumerate(test_ids)}\n",
    "test_kp, test_box = np.load(POSE_CACHE / \"pose_test.npy\"), np.load(POSE_CACHE / \"box_test.npy\")\n",
    "X_pose_test = np.stack([pose_vector(test_kp[row_of_id[i]], test_box[row_of_id[i]]) for i in sub[\"id\"]])\n",
    "print(X_pose.shape, X_pose_test.shape)"
